<%- include('partials/header') %>

<div class="container">
  <div class="page-title">
    <h1>📋 Transaction History</h1>
  </div>

  <% if (transactions.length === 0) { %>
    <div class="card" style="text-align:center;padding:40px;">
      <p style="color:gray;">No transaction is done yet.</p>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Date</th>
          <th>Stock</th>
          <th>Type</th>
          <th>Quantity</th>
          <th>Price</th>
          <th>Total Amount</th>
        </tr>
      </thead>
      <tbody>
        <% transactions.forEach(t => { %>
        <tr>
          <td><%= new Date(t.date).toLocaleDateString('hi-IN') %></td>
          <td><strong><%= t.stockName %></strong></td>
          <td>
            <span class="badge <%= t.type === 'BUY' ? 'badge-buy' : 'badge-sell' %>">
              <%= t.type %>
            </span>
          </td>
          <td><%= t.quantity %></td>
          <td>₹<%= (t.price || 0).toFixed(2) %></td>
          <td>₹<%= (t.total || 0).toFixed(2) %></td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>