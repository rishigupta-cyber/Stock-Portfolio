<%- include('partials/header') %>

<div class="container">
  <div class="page-title">
    <h1>📊 My Portfolio</h1>
    <a href="/portfolio/add" class="btn btn-primary">+ Add Stock</a>
  </div>

  <!-- Search & Filter -->
  <form class="search-bar" method="GET" action="/portfolio">
    <input type="text" name="search" placeholder="Search by stock name..." value="<%= search %>">
    <select name="filter" style="padding:9px 14px;border:1px solid gainsboro;border-radius:6px;font-size:14px;">
      <option value="" <%= filter === '' ? 'selected' : '' %>>All Stocks</option>
      <option value="profit" <%= filter === 'profit' ? 'selected' : '' %>>Only profit ones</option>
      <option value="loss" <%= filter === 'loss' ? 'selected' : '' %>>Only loss ones</option>
    </select>
    <button type="submit" class="btn btn-info">Search</button>
    <a href="/portfolio" class="btn btn-warning">Reset</a>
  </form>

  <% if (stocks.length === 0) { %>
    <div class="card" style="text-align:center;padding:40px;">
      <p style="color:gray;margin-bottom:15px;">Didn't got any stock.</p>
      <a href="/portfolio/add" class="btn btn-primary">add first Stock</a>
    </div>
  <% } else { %>
    <table>
      <thead>
        <tr>
          <th>Stock Name</th>
          <th>Quantity</th>
          <th>Buy Price</th>
          <th>Current Price</th>
          <th>Investment</th>
          <th>Current Value</th>
          <th>P/L</th>
          <th>Actions</th>
        </tr>
      </thead>
      <tbody>
        <% stocks.forEach(stock => {
          const investment = (stock.buyPrice * stock.quantity).toFixed(2);
          const currentVal = (stock.currentPrice * stock.quantity).toFixed(2);
          const pl = (currentVal - investment).toFixed(2);
        %>
        <tr>
          <td><strong><%= stock.stockName %></strong></td>
          <td><%= stock.quantity %></td>
          <td>₹<%= stock.buyPrice %></td>
          <td>₹<%= stock.currentPrice %></td>
          <td>₹<%= investment %></td>
          <td>₹<%= currentVal %></td>
          <td class="<%= pl >= 0 ? 'profit' : 'loss' %>"><%= pl >= 0 ? '+' : '' %>₹<%= pl %></td>
          <td>
            <a href="/portfolio/edit/<%= stock._id %>" class="btn btn-warning">Edit</a>

            <form action="/portfolio/sell/<%= stock._id %>" method="POST" style="display:inline;"
              onsubmit="return confirm('Do you want to sell this stock?')">
              <button type="submit" class="btn btn-success">Sell</button>
            </form>

            <form action="/portfolio/delete/<%= stock._id %>" method="POST" style="display:inline;"
              onsubmit="return confirm('Do you want to delete this stock?')">
              <button type="submit" class="btn btn-danger">Delete</button>
            </form>
          </td>
        </tr>
        <% }) %>
      </tbody>
    </table>
  <% } %>
</div>

<%- include('partials/footer') %>