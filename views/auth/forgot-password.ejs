<!DOCTYPE html>
<html lang="hi">
<head>
  <meta charset="UTF-8">
  <title>Forgot Password</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">

<div class="form-card">
  <div class="logo">📈 StockPortfolio</div>
  <p class="sub">OTP will be sent to your Email</p>

  <% if (error) { %>
    <div class="alert alert-error">⚠️ <%= error %></div>
  <% } %>
  <% if (success) { %>
    <div class="alert alert-success">✅ <%= success %></div>
    <a href="/verify-otp" class="btn btn-success" style="width:100%;text-align:center;padding:11px;">Enter the OTP →</a>
  <% } else { %>
    <form action="/forgot-password" method="POST">
      <div class="form-group">
        <label>Registered Email</label>
        <input type="email" name="email" placeholder="your@email.com" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;padding:11px;">Send OTP</button>
    </form>
  <% } %>

  <p style="text-align:center;margin-top:15px;font-size:13px;">
    <a href="/login">← Go back to login</a>
  </p>
</div>

</body>
</html>