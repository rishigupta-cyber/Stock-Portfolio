<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Sign Up — StockFolio</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">

<div class="auth-card">

  <% if (step === 'otp') { %>

    <div class="auth-logo">&#x25B2; StockFolio</div>
    <p class="auth-subtitle">OTP sent to <strong style="color:seagreen"><%= email %></strong></p>

    <% if (error) { %>
      <div class="alert alert-error">&#9888; <%= error %></div>
    <% } %>

    <form action="/signup/verify" method="POST">
      <div class="form-group">
        <label>Enter OTP</label>
        <input type="text" name="otp" placeholder="• • • • • •" maxlength="6" required
          style="letter-spacing:8px;font-size:22px;text-align:center;font-weight:700;">
      </div>
      <button type="submit" class="btn btn-primary"
        style="width:100%;justify-content:center;padding:13px;font-size:14px;margin-top:8px;">
        Verify &amp; Create Account
      </button>
    </form>

    <div class="auth-link" style="margin-top:16px;">
      Wrong email? <a href="/signup">Go back</a>
    </div>

  <% } else { %>

    <div class="auth-logo">&#x25B2; Stock Portfolio</div>
    <p class="auth-subtitle">Create your free account</p>

    <% if (error) { %>
      <div class="alert alert-error">&#9888; <%= error %></div>
    <% } %>

    <form action="/signup" method="POST">
      <div class="form-group">
        <label>Full Name</label>
        <input type="text" name="name" placeholder="John Doe" required>
      </div>
      <div class="form-group">
        <label>Email Address</label>
        <input type="email" name="email" placeholder="you@gmail.com" required>
      </div>
      <div class="form-group">
        <label>Password</label>
        <input type="password" name="password" placeholder="Min. 6 characters" minlength="6" required>
      </div>
      <button type="submit" class="btn btn-primary"
        style="width:100%;justify-content:center;padding:13px;font-size:14px;margin-top:8px;">
        Send Verification OTP
      </button>
    </form>

    <hr class="divider">

    <div class="auth-link">
      Already have an account? <a href="/login">Sign in</a>
    </div>

  <% } %>

</div>

</body>
</html>