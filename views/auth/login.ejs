<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Login — StockFolio</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body class="auth-page">

<div class="auth-card">

  <div class="auth-logo">📈 Stock Portfolio</div>
  <p class="auth-subtitle">Login to your account</p>

  <% if (error) { %>
    <div class="alert alert-error">⚠️ <%= error %></div>
  <% } %>

  <form action="/login" method="POST">
    <div class="form-group">
      <label>Email</label>
      <input type="email" name="email" placeholder="you@gmail.com" required>
    </div>
    <div class="form-group">
      <label>Password</label>
      <input type="password" name="password" placeholder="••••••••" required>
    </div>
    <button type="submit" class="btn btn-primary"
      style="width:100%;justify-content:center;padding:13px;font-size:15px;margin-top:8px;">
      Login
    </button>
  </form>

  <div class="auth-link" style="margin-top:20px;">
    <a href="/forgot-password">Forgot password?</a>
    &nbsp;|&nbsp;
    Account does not exist? <a href="/signup">Signup</a>
  </div>

</div>

</body>
</html>