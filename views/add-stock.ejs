<%- include('partials/header') %>

<div class="container">
  <div class="form-card" style="max-width:550px;margin:30px auto;">
    <h2>➕ Add New Stock</h2>

    <% if (error) { %>
      <div class="alert alert-error">⚠️ <%= error %></div>
    <% } %>

    <form action="/portfolio/add" method="POST">
      <div class="form-group">
        <label>Stock Name (e.g. Reliance, TCS)</label>
        <input type="text" name="stockName" placeholder="Stock Name" required>
      </div>
      <div class="form-group">
        <label>Quantity (How many shares purchased)</label>
        <input type="number" name="quantity" placeholder="e.g. 10" min="1" required>
      </div>
      <div class="form-group">
        <label>Buy Price (₹ per share)</label>
        <input type="number" name="buyPrice" placeholder="e.g. 2500" step="0.01" min="0" required>
      </div>
      <div class="form-group">
        <label>Current Price (₹ per share)</label>
        <input type="number" name="currentPrice" placeholder="e.g. 2650" step="0.01" min="0" required>
      </div>
      <button type="submit" class="btn btn-primary" style="width:100%;padding:11px;">Stock Add </button>
    </form>
    <p style="text-align:center;margin-top:15px;"><a href="/portfolio">← Back to Portfolio</a></p>
  </div>
</div>

<%- include('partials/footer') %>